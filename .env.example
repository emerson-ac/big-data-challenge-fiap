# Reproducibility
RANDOM_SEED=42

# Application (API)
APP_NAME=Recommendation API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Data and artifact locations
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models
CONFIG_PATH=configs/model_config.yaml

# Recommender
RECOMMENDER_TYPE=item_based_cf
SIMILARITY_PATH=models/item_based_cf/item_similarity.npz
INTERACTIONS_PATH=data/processed/interactions_prior.npz
POPULARITY_PATH=models/baseline_popularity/ranking.pkl
VOCAB_PATH=data/processed/vocabularies.pkl

DEFAULT_TOP_K=10
MAX_TOP_K=100

# Logging
LOG_LEVEL=INFO

# MLflow tracking (Etapa 3): file store local (mlruns/) ou servidor (http://localhost:5000)
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=tech-challenge-recsys

# Model Registry + serving (Etapa 4)
REGISTERED_MODEL_NAME=item_based_cf_recommender
MODEL_ALIAS=production
MODEL_SOURCE=local
