# Configuração do sistema de recomendação (Pydantic Settings, prefixo RECSYS_).
# Copie para .env e ajuste conforme o ambiente. .env NÃO é versionado.

# Reprodutibilidade
RECSYS_RANDOM_SEED=42

# Rastreamento MLflow — servidor externo (tech-challenger). Artefatos são
# proxiados (mlflow-artifacts:/...), portanto NÃO são necessárias credenciais AWS.
# Para dev offline, use um backend sqlite (o file store saiu no MLflow 3): sqlite:///mlflow.db
RECSYS_MLFLOW_TRACKING_URI=https://mlflow.pocsarcotech.com

# Fonte do modelo no serving: registry (carrega do MLflow) ou local (artefatos em disco)
RECSYS_MODEL_SOURCE=registry

# Modelo servido pela API/inference (registrado como @production no Model Registry)
RECSYS_MODEL_TYPE=item_based_cf
RECSYS_DEFAULT_K=10

# API FastAPI
RECSYS_API_HOST=0.0.0.0
RECSYS_API_PORT=8000

# ---------------------------------------------------------------------------
# BÔNUS — deploy KServe/EKS (scripts/*.sh). Só necessário para a Opção 2.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
EKS_CLUSTER=arcobridgegitops
AWS_ACCOUNT_ID=177300752486
MODELS_BUCKET=arcobridgegitops-models-177300752486
PUBLIC_HOST=iris.pocsarcotech.com
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:177300752486:certificate/eebc6271-527b-45a6-99b8-b7b888cdbdc2
